---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  locale="en"
  title="Page not found | Leandro Alonso"
  description="The page you requested could not be found."
  pathname="/404"
  alternatePath="/es/404"
  indexable={false}
>
  <main id="main-content" class="not-found container">
    <p class="eyebrow">404</p>
    <h1>This route stepped outside the storefront.</h1>
    <p>The page may have moved, or the address may be incomplete.</p>
    <a class="button button--primary" href="/">Back to the portfolio</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    min-height: 80svh;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-block: 9rem 5rem;
  }

  h1 {
    max-width: 13ch;
    margin-top: 1.5rem;
    font-size: var(--text-h2);
    font-weight: 560;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  main > p:nth-of-type(2) {
    max-width: 34rem;
    margin-top: 1.3rem;
    color: var(--color-text-muted);
  }

  .button {
    margin-top: 2rem;
  }
</style>
