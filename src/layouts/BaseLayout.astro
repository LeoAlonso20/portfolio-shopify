---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl, siteConfig, type Locale } from '../config/site';
import { getUi } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  pathname: string;
  alternatePath: string;
  isHome?: boolean;
  headerVariant?: 'shopify' | 'professional';
  pageTheme?: 'shopify' | 'professional' | 'gateway';
  showChrome?: boolean;
  ogType?: 'website' | 'article';
  indexable?: boolean;
}

const {
  locale,
  title,
  description,
  pathname,
  alternatePath,
  isHome = false,
  headerVariant = 'shopify',
  pageTheme = headerVariant,
  showChrome = true,
  ogType = 'website',
  indexable = true,
} = Astro.props;
const copy = getUi(locale);
const canonical = absoluteUrl(pathname);
const englishPath = locale === 'en' ? pathname : alternatePath;
const spanishPath = locale === 'es' ? pathname : alternatePath;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteConfig.siteUrl}/#person`,
      name: siteConfig.name,
      jobTitle: siteConfig.title,
      email: `mailto:${siteConfig.email}`,
      url: siteConfig.siteUrl,
      sameAs: [siteConfig.social.linkedin, siteConfig.social.github],
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: siteConfig.education.institution,
      },
      knowsAbout: [
        'Shopify development',
        'Ecommerce frontend development',
        'Web performance',
        'Ecommerce UX',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteConfig.siteUrl}/#website`,
      url: siteConfig.siteUrl,
      name: `${siteConfig.name} — ${siteConfig.title}`,
      inLanguage: ['en', 'es'],
      publisher: { '@id': `${siteConfig.siteUrl}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#060806" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={absoluteUrl(englishPath)} />
    <link rel="alternate" hreflang="es" href={absoluteUrl(spanishPath)} />
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(englishPath)} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Leandro Alonso" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_AR'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'es_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <ClientRouter fallback="animate" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body data-theme={pageTheme}>
    <a class="skip-link" href="#main-content">{copy.accessibility.skip}</a>
    {
      showChrome && (
        <Header {locale} {alternatePath} {isHome} pathname={pathname} variant={headerVariant} />
      )
    }
    <slot />
    {showChrome && <Footer {locale} {alternatePath} pathname={pathname} variant={headerVariant} />}

    <script>
      let pageController: AbortController | undefined;
      let revealObserver: IntersectionObserver | undefined;
      let sectionObserver: IntersectionObserver | undefined;
      let metricObserver: IntersectionObserver | undefined;
      let videoObserver: IntersectionObserver | undefined;

      function initializePage() {
        pageController?.abort();
        revealObserver?.disconnect();
        sectionObserver?.disconnect();
        metricObserver?.disconnect();
        videoObserver?.disconnect();
        pageController = new AbortController();
        const { signal } = pageController;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        document.documentElement.dataset.motion = reducedMotion ? 'reduced' : 'enhanced';

        const header = document.querySelector<HTMLElement>('[data-site-header]');
        const updateHeader = () => {
          if (header) header.dataset.scrolled = String(window.scrollY > 18);
        };
        updateHeader();
        window.addEventListener('scroll', updateHeader, { passive: true, signal });

        const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
        const mobileSummary = mobileMenu?.querySelector<HTMLElement>('summary');
        const backgroundElements = document.querySelectorAll<HTMLElement>(
          'body > main, body > footer, body > .skip-link',
        );
        const syncMenuState = () => {
          if (!mobileMenu || !mobileSummary) return;
          const isOpen = mobileMenu.open;
          mobileSummary.setAttribute('aria-expanded', String(isOpen));
          mobileSummary.setAttribute(
            'aria-label',
            isOpen
              ? (mobileSummary.dataset.closeLabel ?? '')
              : (mobileSummary.dataset.openLabel ?? ''),
          );
          document.body.toggleAttribute('data-nav-open', isOpen);
          backgroundElements.forEach((element) => {
            element.inert = isOpen;
          });
        };
        mobileMenu?.addEventListener('toggle', syncMenuState, { signal });
        mobileMenu?.querySelectorAll('a').forEach((link) => {
          link.addEventListener(
            'click',
            () => {
              mobileMenu.open = false;
              syncMenuState();
            },
            { signal },
          );
        });
        document.addEventListener(
          'keydown',
          (event) => {
            if (event.key === 'Escape' && mobileMenu?.open) {
              mobileMenu.open = false;
              syncMenuState();
              mobileSummary?.focus();
            }

            if (event.key === 'Tab' && mobileMenu?.open) {
              const focusable = Array.from(
                mobileMenu.querySelectorAll<HTMLElement>(
                  'summary, a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
                ),
              ).filter((element) => element.getClientRects().length > 0);
              const first = focusable.at(0);
              const last = focusable.at(-1);

              if (!first || !last) return;
              if (event.shiftKey && document.activeElement === first) {
                event.preventDefault();
                last.focus();
              } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first.focus();
              } else if (!mobileMenu.contains(document.activeElement)) {
                event.preventDefault();
                first.focus();
              }
            }
          },
          { signal },
        );
        signal.addEventListener(
          'abort',
          () => {
            backgroundElements.forEach((element) => {
              element.inert = false;
            });
          },
          { once: true },
        );
        syncMenuState();

        document.querySelectorAll<HTMLInputElement>('[data-comparison-range]').forEach((range) => {
          const comparison = range.closest<HTMLElement>('[data-comparison]');
          const frame = comparison?.querySelector<HTMLElement>('[data-comparison-frame]');
          const update = () => comparison?.style.setProperty('--comparison', `${range.value}%`);
          const updateFromPointer = (event: PointerEvent) => {
            if (!frame) return;
            const rect = frame.getBoundingClientRect();
            const value = Math.round(((event.clientX - rect.left) / rect.width) * 100);
            range.value = String(Math.max(0, Math.min(100, value)));
            update();
          };
          update();
          range.addEventListener('input', update, { signal });
          frame?.addEventListener(
            'pointerdown',
            (event) => {
              if (event.button !== 0) return;
              event.preventDefault();
              range.focus({ preventScroll: true });
              frame.setPointerCapture(event.pointerId);
              updateFromPointer(event);
            },
            { signal },
          );
          frame?.addEventListener(
            'pointermove',
            (event) => {
              if (!frame.hasPointerCapture(event.pointerId)) return;
              updateFromPointer(event);
            },
            { signal },
          );
          frame?.addEventListener(
            'pointerup',
            (event) => {
              if (frame.hasPointerCapture(event.pointerId))
                frame.releasePointerCapture(event.pointerId);
            },
            { signal },
          );
          frame?.addEventListener(
            'pointercancel',
            (event) => {
              if (frame.hasPointerCapture(event.pointerId))
                frame.releasePointerCapture(event.pointerId);
            },
            { signal },
          );
        });

        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
          if (!finePointer || reducedMotion) return;
          card.addEventListener(
            'pointermove',
            (event) => {
              const rect = card.getBoundingClientRect();
              card.style.setProperty('--pointer-x', `${event.clientX - rect.left}px`);
              card.style.setProperty('--pointer-y', `${event.clientY - rect.top}px`);
            },
            { signal },
          );
        });

        document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((element) => {
          if (!finePointer || reducedMotion) return;
          const reset = () => {
            element.style.setProperty('--tilt-x', '0deg');
            element.style.setProperty('--tilt-y', '0deg');
          };
          element.addEventListener(
            'pointermove',
            (event) => {
              const rect = element.getBoundingClientRect();
              const x = (event.clientX - rect.left) / rect.width - 0.5;
              const y = (event.clientY - rect.top) / rect.height - 0.5;
              element.style.setProperty('--tilt-x', `${(-y * 1.4).toFixed(2)}deg`);
              element.style.setProperty('--tilt-y', `${(x * 1.8).toFixed(2)}deg`);
            },
            { signal },
          );
          element.addEventListener('pointerleave', reset, { signal });
          signal.addEventListener('abort', reset, { once: true });
        });

        document.querySelectorAll<HTMLElement>('.button, .header-cta').forEach((element) => {
          if (!finePointer || reducedMotion) return;
          const reset = () => {
            element.style.setProperty('--magnetic-x', '0px');
            element.style.setProperty('--magnetic-y', '0px');
          };
          element.addEventListener(
            'pointermove',
            (event) => {
              const rect = element.getBoundingClientRect();
              const x = ((event.clientX - rect.left) / rect.width - 0.5) * 5;
              const y = ((event.clientY - rect.top) / rect.height - 0.5) * 4;
              element.style.setProperty('--magnetic-x', `${x.toFixed(2)}px`);
              element.style.setProperty('--magnetic-y', `${y.toFixed(2)}px`);
            },
            { signal },
          );
          element.addEventListener('pointerleave', reset, { signal });
          element.addEventListener('blur', reset, { signal });
          signal.addEventListener('abort', reset, { once: true });
        });

        document.querySelectorAll<HTMLButtonElement>('[data-copy-password]').forEach((button) => {
          button.addEventListener(
            'click',
            async () => {
              const value = button.dataset.copyPassword;
              if (!value) return;
              await navigator.clipboard.writeText(value);
              const status = button.querySelector<HTMLElement>('[data-copy-status]');
              if (status) status.textContent = button.dataset.copiedLabel ?? '';
            },
            { signal },
          );
        });

        const videoMotionAllowed = !reducedMotion && finePointer && window.innerWidth >= 768;
        const resetAssetVideo = (video: HTMLVideoElement) => {
          const frame = video.closest<HTMLElement>('[data-asset-video-frame]');
          video.pause();
          video.removeAttribute('src');
          video.load();
          frame?.removeAttribute('data-video-active');
        };
        document.querySelectorAll<HTMLVideoElement>('[data-asset-video]').forEach((video) => {
          resetAssetVideo(video);
        });

        if (videoMotionAllowed) {
          videoObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                const video = entry.target as HTMLVideoElement;
                const frame = video.closest<HTMLElement>('[data-asset-video-frame]');
                const source = video.dataset.videoSrc;
                if (!source) return;

                if (!entry.isIntersecting) {
                  video.pause();
                  return;
                }

                if (!video.getAttribute('src')) {
                  video.src = source;
                  video.load();
                }

                void video
                  .play()
                  .then(() => {
                    frame?.setAttribute('data-video-active', 'true');
                  })
                  .catch(() => {
                    resetAssetVideo(video);
                  });
              });
            },
            { rootMargin: '180px 0px', threshold: 0.08 },
          );

          document.querySelectorAll<HTMLVideoElement>('[data-asset-video]').forEach((video) => {
            video.addEventListener(
              'canplay',
              () => {
                video
                  .closest<HTMLElement>('[data-asset-video-frame]')
                  ?.setAttribute('data-video-active', 'true');
              },
              { once: true, signal },
            );
            video.addEventListener('error', () => resetAssetVideo(video), { signal });
            videoObserver?.observe(video);
            signal.addEventListener('abort', () => resetAssetVideo(video), { once: true });
          });
        }

        if (!reducedMotion) {
          revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  (entry.target as HTMLElement).dataset.revealVisible = 'true';
                  revealObserver?.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          document.querySelectorAll<HTMLElement>('.reveal').forEach((element) => {
            element.dataset.revealReady = 'true';
            revealObserver?.observe(element);
          });

          sectionObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                (entry.target as HTMLElement).dataset.sectionVisible = 'true';
                sectionObserver?.unobserve(entry.target);
              });
            },
            { rootMargin: '0px 0px -12% 0px', threshold: 0.02 },
          );
          document.querySelectorAll<HTMLElement>('.section--bordered').forEach((section) => {
            sectionObserver?.observe(section);
          });

          const animateMetric = (element: HTMLElement) => {
            const finalValue = element.dataset.countup ?? element.textContent?.trim() ?? '';
            const match = finalValue.match(/^(\D*)(\d+(?:\.\d+)?)(.*)$/);
            if (!match) return;
            const [, prefix = '', numeric = '0', suffix = ''] = match;
            const target = Number(numeric);
            const decimals = numeric.includes('.') ? (numeric.split('.')[1]?.length ?? 0) : 0;
            const start = performance.now();
            const duration = 820;
            const tick = (time: number) => {
              const progress = Math.min((time - start) / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 4);
              element.textContent = `${prefix}${(target * eased).toFixed(decimals)}${suffix}`;
              if (progress < 1) requestAnimationFrame(tick);
              else element.textContent = finalValue;
            };
            requestAnimationFrame(tick);
          };

          metricObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                animateMetric(entry.target as HTMLElement);
                metricObserver?.unobserve(entry.target);
              });
            },
            { threshold: 0.7 },
          );
          document.querySelectorAll<HTMLElement>('[data-countup]').forEach((metric) => {
            metricObserver?.observe(metric);
          });

          if (finePointer && window.innerWidth >= 768) {
            const depthElements = Array.from(
              document.querySelectorAll<HTMLElement>('[data-depth]'),
            );
            let depthFrame = 0;
            const updateDepth = () => {
              depthFrame = 0;
              depthElements.forEach((element) => {
                const rect = element.getBoundingClientRect();
                const distance = rect.top + rect.height / 2 - window.innerHeight / 2;
                const progress = Math.max(-1, Math.min(1, distance / window.innerHeight));
                element.style.setProperty('--depth-y', `${(-progress * 10).toFixed(2)}px`);
              });
            };
            const requestDepthUpdate = () => {
              if (!depthFrame) depthFrame = requestAnimationFrame(updateDepth);
            };
            updateDepth();
            window.addEventListener('scroll', requestDepthUpdate, { passive: true, signal });
            window.addEventListener('resize', requestDepthUpdate, { passive: true, signal });
            signal.addEventListener(
              'abort',
              () => {
                if (depthFrame) cancelAnimationFrame(depthFrame);
              },
              { once: true },
            );
          }
        }
      }

      document.addEventListener('astro:page-load', initializePage);
    </script>
  </body>
</html>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }

  body[data-nav-open] {
    overflow: hidden;
  }
</style>
