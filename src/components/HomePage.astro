---
import { getCollection } from 'astro:content';
import BeforeAfter from './BeforeAfter.astro';
import AssetImage from './AssetImage.astro';
import ContactCTA from './ContactCTA.astro';
import HeroVisual from './HeroVisual.astro';
import Icon from './Icon.astro';
import ProjectCard from './ProjectCard.astro';
import SectionHeader from './SectionHeader.astro';
import { projects } from '../config/projects';
import { shopifyPath, siteConfig, type Locale } from '../config/site';
import { getUi } from '../i18n/ui';
import { publicAssetPath } from '../lib/assets';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getUi(locale);
const pathname = shopifyPath(locale);
const alternatePath = shopifyPath(locale === 'en' ? 'es' : 'en');
const hasAboutSignature = Boolean(publicAssetPath(siteConfig.assets.aboutSignature));
const entries = (await getCollection('caseStudies'))
  .filter((entry) => entry.data.locale === locale)
  .sort((a, b) => projects[a.data.projectKey].order - projects[b.data.projectKey].order);
---

<BaseLayout
  {locale}
  title={copy.seo.homeTitle}
  description={copy.seo.homeDescription}
  {pathname}
  {alternatePath}
  isHome
>
  <main id="main-content">
    <section class="hero-section">
      <div class="hero-grid container">
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow">{copy.hero.eyebrow}</p>
          <h1>
            {copy.hero.headlineStart}<span>{copy.hero.headlineAccent}</span>{copy.hero.headlineEnd}
          </h1>
          <p class="hero-body">{copy.hero.body}</p>
          <div class="hero-actions">
            <a class="button button--primary" href="#contact">
              {copy.hero.primaryCta}<Icon name="ArrowUpRight" size={18} />
            </a>
            <a class="button button--secondary" href="#work">
              {copy.hero.secondaryCta}<Icon name="ArrowRight" size={17} />
            </a>
          </div>
          <div class="hero-meta">
            <span><i></i>{copy.hero.availability}</span>
            <span><Icon name="MapPin" size={14} />{copy.hero.location}</span>
          </div>
        </div>
        <HeroVisual
          {locale}
          label={copy.hero.visualLabel}
          product={copy.hero.visualProduct}
          detail={copy.hero.visualDetail}
          cta={copy.hero.visualCta}
          performance={copy.hero.performance}
          performanceValue={copy.hero.performanceValue}
          uxNote={copy.hero.uxNote}
          uxValue={copy.hero.uxValue}
        />
      </div>
      <div class="hero-index container" aria-hidden="true">
        <span>01</span><i></i><span>06</span>
      </div>
    </section>

    <section class="credibility">
      <div
        class="credibility-list container"
        role="region"
        aria-label={locale === 'en' ? 'Working principles' : 'Principios de trabajo'}
        tabindex="0"
      >
        {
          copy.credibility.map((item, index) => (
            <div
              class="credibility-item reveal"
              data-reveal="soft"
              style={`--reveal-delay: ${index * 45}ms`}
            >
              <Icon name={item.icon} size={16} />
              <span>{item.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section id="services" class="section services-section section--bordered">
      <div class="services-layout container">
        <SectionHeader
          eyebrow={copy.services.eyebrow}
          title={copy.services.title}
          intro={copy.services.intro}
          wide
        />
        <div class="service-list">
          {
            copy.services.items.map((service, index) => (
              <article
                class="service-row reveal"
                data-reveal="soft"
                style={`--reveal-delay: ${index * 55}ms`}
              >
                <span class="service-number">{service.number}</span>
                <span class="service-icon">
                  <Icon name={service.icon} size={20} />
                </span>
                <div>
                  <h3>{service.title}</h3>
                  <p>{service.description}</p>
                  <small>{service.detail}</small>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section improvement-section section--bordered">
      <div class="container">
        <div class="improvement-heading">
          <SectionHeader
            eyebrow={copy.comparison.eyebrow}
            title={copy.comparison.title}
            intro={copy.comparison.body}
            wide
          />
          <ul class="improvement-notes reveal" data-reveal="soft" style="--reveal-delay: 140ms">
            {
              copy.comparison.notes.map((note) => (
                <li>
                  <Icon name="Check" size={14} />
                  {note}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="comparison-wrap reveal" data-reveal="scale">
          <BeforeAfter
            {locale}
            before={copy.comparison.before}
            after={copy.comparison.after}
            beforeSrc={projects['rytual-cafe'].assets.before}
            afterSrc={projects['rytual-cafe'].assets.after}
            beforeVideoSrc={projects['rytual-cafe'].videos.before}
            afterVideoSrc={projects['rytual-cafe'].videos.after}
            rangeLabel={copy.comparison.rangeLabel}
            ariaLabel={copy.accessibility.comparison}
            projectHint={copy.comparison.projectHint}
          />
        </div>
      </div>
    </section>

    <section id="work" class="section work-section section--bordered">
      <div class="container">
        <SectionHeader
          eyebrow={copy.work.eyebrow}
          title={copy.work.title}
          intro={copy.work.intro}
          wide
          class="work-heading"
        />
        <div class="work-grid">
          {
            entries.map((entry, index) => (
              <ProjectCard
                entry={entry}
                project={projects[entry.data.projectKey]}
                {locale}
                cta={copy.work.viewCaseStudy}
                metricLabel={copy.work.metricLabel}
                featured={index === 0}
                revealDelay={index * 65}
              />
            ))
          }
        </div>
      </div>
    </section>

    <section class="section engineering-section section--bordered">
      <div class="engineering-layout container">
        <div>
          <SectionHeader
            eyebrow={copy.engineering.eyebrow}
            title={copy.engineering.title}
            intro={copy.engineering.intro}
            wide
          />
          <div class="stack reveal" data-reveal="soft" style="--reveal-delay: 130ms">
            <p>{copy.engineering.stackLabel}</p>
            <ul>
              {copy.engineering.stack.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
        <div class="principles-grid">
          {
            copy.engineering.items.map((item, index) => (
              <article
                class="principle reveal"
                data-reveal="scale"
                style={`--reveal-delay: ${index * 55}ms`}
              >
                <span>
                  <Icon name={item.icon} size={20} />
                </span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="about" class="section about-section section--bordered">
      <div class="about-grid container">
        <div class="portrait-placeholder reveal" data-reveal="clip">
          <AssetImage
            src={siteConfig.assets.portrait}
            alt={copy.about.portraitAlt}
            width={1600}
            height={2000}
            sizes="(max-width: 768px) calc(100vw - 40px), 38vw"
            class="portrait-image"
            depth
          >
            <div class="portrait-fallback" role="img" aria-label={copy.about.portraitLabel}>
              <div class="portrait-initials" aria-hidden="true">LA</div>
              <div class="portrait-lines" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
              <span class="portrait-status"><i></i>{copy.about.portraitStatus}</span>
              <p aria-hidden="true">LEANDRO<br />ALONSO</p>
            </div>
          </AssetImage>
        </div>
        <div class="about-content">
          <p class="eyebrow reveal" data-reveal="soft">{copy.about.eyebrow}</p>
          <h2
            class="section-heading section-heading--wide reveal"
            data-reveal="soft"
            style="--reveal-delay: 55ms"
          >
            {copy.about.title}
          </h2>
          <div class="about-copy reveal" data-reveal="soft" style="--reveal-delay: 105ms">
            {copy.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          {
            hasAboutSignature && (
              <div
                class="about-signature-wrap reveal"
                data-reveal="soft"
                style="--reveal-delay: 130ms"
              >
                <AssetImage
                  src={siteConfig.assets.aboutSignature}
                  alt=""
                  width={1370}
                  height={512}
                  sizes="(max-width: 768px) 14rem, 18rem"
                  class="about-signature"
                />
              </div>
            )
          }
          <dl class="about-details reveal" data-reveal="soft" style="--reveal-delay: 155ms">
            <div>
              <dt><Icon name="Code" size={17} />{copy.about.role}</dt>
              <dd>Córdoba, Argentina</dd>
            </div>
            <div>
              <dt><Icon name="GraduationCap" size={17} />{copy.about.educationLabel}</dt>
              <dd>{copy.about.education}<span>{copy.about.educationSchool}</span></dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="section why-section section--bordered">
      <div class="container">
        <SectionHeader
          eyebrow={copy.why.eyebrow}
          title={copy.why.title}
          intro={copy.why.intro}
          wide
        />
        <div class="why-grid">
          {
            copy.why.items.map((item, index) => (
              <article
                class="why-item reveal"
                data-reveal="soft"
                style={`--reveal-delay: ${index * 55}ms`}
              >
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <ContactCTA {locale} />
  </main>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    display: flex;
    min-height: min(62rem, 100svh);
    align-items: center;
    overflow: hidden;
    padding-block: clamp(8.5rem, 13vh, 11rem) 5rem;
  }

  .hero-grid {
    display: grid;
    min-width: 0;
    align-items: center;
    grid-template-columns: minmax(0, 1.2fr) minmax(27rem, 0.8fr);
    gap: clamp(2.5rem, 4vw, 5rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow {
    animation: hero-in 700ms var(--ease-out) 80ms both;
  }

  .hero-copy h1 {
    max-width: 15.5ch;
    margin-top: 1.55rem;
    font-size: clamp(3rem, 1.75rem + 3.25vw, 5.35rem);
    font-weight: 560;
    letter-spacing: -0.064em;
    line-height: 0.93;
    text-wrap: balance;
    animation: hero-in 800ms var(--ease-out) 150ms both;
  }

  .hero-copy h1 span {
    color: var(--color-accent);
  }

  .hero-body {
    max-width: 39rem;
    margin-top: 1.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-lead);
    line-height: 1.62;
    animation: hero-in 800ms var(--ease-out) 220ms both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
    animation: hero-in 800ms var(--ease-out) 290ms both;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.59rem;
    letter-spacing: 0.02em;
    animation: hero-in 800ms var(--ease-out) 360ms both;
  }

  .hero-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-meta i {
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow:
      0 0 0 4px rgb(200 255 69 / 7%),
      0 0 14px rgb(200 255 69 / 36%);
  }

  .hero-index {
    position: absolute;
    right: 0;
    bottom: 1.5rem;
    left: 0;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    animation: hero-in 700ms var(--ease-out) 430ms both;
  }

  .hero-index i {
    width: 3rem;
    height: 1px;
    background: linear-gradient(to right, var(--color-accent) 28%, var(--color-line-strong) 28%);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 1.2rem;
    }
  }

  .credibility {
    border-block: 1px solid var(--color-line);
    background: rgb(9 12 9 / 70%);
  }

  .credibility-list {
    display: grid;
    min-height: 5.4rem;
    align-items: center;
    grid-template-columns: repeat(5, 1fr);
  }

  .credibility-item {
    display: flex;
    min-height: 2.3rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border-right: 1px solid var(--color-line);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 590;
    letter-spacing: -0.01em;
  }

  .credibility-item:first-child {
    border-left: 1px solid var(--color-line);
  }

  .credibility-item :global(svg) {
    color: var(--color-accent);
  }

  .services-layout {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(18rem, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .services-layout > :global(.section-copy) {
    position: sticky;
    top: 8rem;
  }

  .service-list {
    border-top: 1px solid var(--color-line);
  }

  .service-row {
    display: grid;
    align-items: start;
    border-bottom: 1px solid var(--color-line);
    grid-template-columns: 2.4rem 3rem 1fr;
    gap: 1rem;
    padding-block: clamp(1.6rem, 3vw, 2.45rem);
    transition: border-color var(--duration-fast) ease;
  }

  .service-number {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.59rem;
  }

  .service-icon {
    display: grid;
    width: 2.55rem;
    height: 2.55rem;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: 0.55rem;
    background: rgb(200 255 69 / 3%);
    color: var(--color-accent);
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  .service-row h3 {
    font-size: var(--text-h3);
    font-weight: 570;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }

  .service-row p {
    max-width: 42rem;
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .service-row small {
    display: block;
    margin-top: 1rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.04em;
  }

  .improvement-section {
    background: linear-gradient(180deg, transparent, rgb(13 18 14 / 42%), transparent);
  }

  .improvement-heading {
    display: grid;
    align-items: end;
    grid-template-columns: 1fr auto;
    gap: 3rem;
  }

  .improvement-notes {
    display: grid;
    list-style: none;
    gap: 0.55rem;
    padding-bottom: 0.35rem;
  }

  .improvement-notes li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .improvement-notes :global(svg) {
    color: var(--color-accent);
  }

  .comparison-wrap {
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }

  .work-heading {
    max-width: 55rem;
  }

  .work-grid {
    display: grid;
    margin-top: clamp(3rem, 6vw, 5rem);
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .engineering-section {
    overflow: hidden;
  }

  .engineering-layout {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 8vw, 8rem);
  }

  .stack {
    margin-top: 3rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }

  .stack > p {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    list-style: none;
  }

  .stack li {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.57rem;
    padding: 0.42rem 0.65rem;
  }

  .principles-grid {
    display: grid;
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
    grid-template-columns: 1fr 1fr;
  }

  .principle {
    min-height: 15rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    transition: background-color var(--duration-normal) ease;
  }

  .principle:last-child {
    grid-column: 1 / -1;
  }

  .principle > span {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border-radius: 0.55rem;
    background: rgb(200 255 69 / 8%);
    color: var(--color-accent);
  }

  .principle h3 {
    margin-top: 1.75rem;
    font-size: 1.12rem;
    font-weight: 630;
    letter-spacing: -0.03em;
  }

  .principle p {
    max-width: 26rem;
    margin-top: 0.65rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .about-grid {
    display: grid;
    align-items: center;
    grid-template-columns: minmax(20rem, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(3rem, 9vw, 9rem);
  }

  .portrait-placeholder {
    position: relative;
    display: grid;
    overflow: hidden;
    aspect-ratio: 0.82;
    place-items: center;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(135deg, transparent 0 48%, rgb(200 255 69 / 4%) 48% 52%, transparent 52%),
      radial-gradient(circle at 50% 35%, rgb(200 255 69 / 8%), transparent 30%), #0c100d;
    box-shadow: var(--shadow-lg);
  }

  :global(.portrait-image),
  .portrait-fallback {
    width: 100%;
    height: 100%;
  }

  :global(.portrait-image) {
    object-fit: cover;
    transform: translate3d(0, var(--depth-y, 0), 0) scale(1.035);
  }

  .portrait-fallback {
    position: relative;
    display: grid;
    place-items: center;
  }

  .portrait-fallback::before,
  .portrait-fallback::after {
    position: absolute;
    border: 1px solid rgb(200 255 69 / 8%);
    border-radius: 50%;
    content: '';
  }

  .portrait-fallback::before {
    width: 65%;
    aspect-ratio: 1;
  }

  .portrait-fallback::after {
    width: 84%;
    aspect-ratio: 1;
  }

  .portrait-initials {
    position: relative;
    z-index: 1;
    color: var(--color-text-soft);
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 240;
    letter-spacing: -0.12em;
    line-height: 1;
    opacity: 0.48;
  }

  .portrait-lines {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: grid;
    gap: 0.3rem;
  }

  .portrait-lines span {
    display: block;
    width: 2.6rem;
    height: 1px;
    background: var(--color-line-strong);
  }

  .portrait-lines span:nth-child(2) {
    width: 1.75rem;
    justify-self: end;
    background: var(--color-accent);
  }

  .portrait-status {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: rgb(8 11 8 / 70%);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.53rem;
    padding: 0.42rem 0.62rem;
  }

  .portrait-status i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .portrait-fallback > p {
    position: absolute;
    bottom: 1rem;
    left: 1.2rem;
    color: rgb(242 244 236 / 10%);
    font-size: clamp(1.2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 0.85;
  }

  .about-copy {
    display: grid;
    max-width: 42rem;
    gap: 1.15rem;
    margin-top: 2rem;
    color: var(--color-text-muted);
    font-size: var(--text-lead);
  }

  .about-signature-wrap {
    width: min(18rem, 58vw);
    margin-top: 1.9rem;
    opacity: 0.86;
  }

  :global(.about-signature) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 18px rgb(255 255 255 / 7%));
  }

  .about-details {
    display: grid;
    margin-top: 2.5rem;
    border-top: 1px solid var(--color-line);
    grid-template-columns: 1fr 1.2fr;
  }

  .about-details > div {
    padding: 1.25rem 1.25rem 0 0;
  }

  .about-details > div + div {
    border-left: 1px solid var(--color-line);
    padding-left: 1.25rem;
  }

  .about-details dt {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    font-weight: 620;
  }

  .about-details dt :global(svg) {
    color: var(--color-accent);
  }

  .about-details dd {
    display: flex;
    flex-direction: column;
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .about-details dd span {
    color: var(--color-text-subtle);
  }

  .why-grid {
    display: grid;
    margin-top: 4rem;
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
