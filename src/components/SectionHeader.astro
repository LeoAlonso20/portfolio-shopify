---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  wide?: boolean;
  class?: string;
}

const { eyebrow, title, intro, wide = false, class: className } = Astro.props;
---

<div class:list={['section-copy', className]}>
  <p class="eyebrow reveal" data-reveal="soft">{eyebrow}</p>
  <h2
    class:list={['section-heading reveal', { 'section-heading--wide': wide }]}
    data-reveal="soft"
    style="--reveal-delay: 55ms"
  >
    {title}
  </h2>
  {
    intro && (
      <p class="section-intro reveal" data-reveal="soft" style="--reveal-delay: 105ms">
        {intro}
      </p>
    )
  }
</div>
