---
import { publicAssetPath, publicAssetSrcset } from '../lib/assets';

interface Props {
  videoSrc?: string | null;
  posterSrc?: string | null;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'sync' | 'async' | 'auto';
  class?: string;
}

const {
  videoSrc,
  posterSrc,
  alt,
  width,
  height,
  sizes,
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async',
  class: className,
} = Astro.props;

const resolvedVideo = publicAssetPath(videoSrc);
const resolvedPoster = publicAssetPath(posterSrc);
const posterSrcset = publicAssetSrcset(posterSrc);
---

{
  resolvedVideo && resolvedPoster ? (
    <div class:list={['asset-video-frame', className]} data-asset-video-frame>
      <img
        src={resolvedPoster}
        srcset={posterSrcset}
        {sizes}
        {alt}
        {width}
        {height}
        {loading}
        {fetchpriority}
        {decoding}
        class="asset-video-poster"
      />
      <video
        class="asset-video"
        data-asset-video
        data-video-src={resolvedVideo}
        poster={resolvedPoster}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      />
    </div>
  ) : resolvedPoster ? (
    <img
      src={resolvedPoster}
      srcset={posterSrcset}
      {sizes}
      {alt}
      {width}
      {height}
      {loading}
      {fetchpriority}
      {decoding}
      class={className}
    />
  ) : (
    <slot />
  )
}

<style>
  .asset-video-frame {
    position: relative;
    overflow: hidden;
    background: #0d110e;
  }

  .asset-video-poster,
  .asset-video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .asset-video {
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms var(--ease-standard);
  }

  .asset-video-frame[data-video-active='true'] .asset-video {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .asset-video {
      display: none;
    }
  }
</style>
