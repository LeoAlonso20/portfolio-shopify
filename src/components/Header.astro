---
import Icon from './Icon.astro';
import AssetImage from './AssetImage.astro';
import { getUi } from '../i18n/ui';
import { homePath, siteConfig, type Locale } from '../config/site';

interface Props {
  locale: Locale;
  alternatePath: string;
  isHome?: boolean;
}

const { locale, alternatePath, isHome = false } = Astro.props;
const copy = getUi(locale);
const root = homePath(locale);
const sectionHref = (section: string) => (isHome ? `#${section}` : `${root}#${section}`);
---

<header class="site-header" data-site-header>
  <div class="header-shell">
    <a class="brand" href={root} aria-label={`Leandro Alonso — ${copy.footer.tagline}`}>
      <AssetImage
        src={siteConfig.assets.signature}
        alt=""
        width={240}
        height={80}
        sizes="72px"
        loading="eager"
        class="brand-signature"
      >
        <span class="brand-mark" aria-hidden="true">LA</span>
      </AssetImage>
      <span class="brand-name">Leandro Alonso</span>
    </a>

    <nav class="desktop-nav" aria-label={copy.accessibility.primaryNav}>
      <a href={sectionHref('work')}>{copy.nav.work}</a>
      <a href={sectionHref('services')}>{copy.nav.services}</a>
      <a href={sectionHref('about')}>{copy.nav.about}</a>
    </nav>

    <div class="desktop-actions">
      <nav class="language-switcher" aria-label={copy.accessibility.language}>
        <a
          href={locale === 'en' ? Astro.url.pathname : alternatePath}
          lang="en"
          hreflang="en"
          aria-current={locale === 'en' ? 'page' : undefined}>EN</a
        >
        <span aria-hidden="true">/</span>
        <a
          href={locale === 'es' ? Astro.url.pathname : alternatePath}
          lang="es"
          hreflang="es"
          aria-current={locale === 'es' ? 'page' : undefined}>ES</a
        >
      </nav>
      <a class="header-cta" href={sectionHref('contact')}>
        <span>{copy.nav.cta}</span>
        <Icon name="ArrowUpRight" size={16} />
      </a>
    </div>

    <details class="mobile-menu" data-mobile-menu>
      <summary
        data-testid="mobile-nav-toggle"
        data-open-label={copy.accessibility.openNav}
        data-close-label={copy.accessibility.closeNav}
        aria-label={copy.accessibility.openNav}
      >
        <span class="menu-icon menu-icon--open"><Icon name="Menu" size={21} /></span>
        <span class="menu-icon menu-icon--close"><Icon name="X" size={21} /></span>
      </summary>
      <div
        class="mobile-panel"
        data-testid="mobile-nav-panel"
        role="dialog"
        aria-modal="true"
        aria-label={copy.accessibility.mobileNav}
      >
        <nav aria-label={copy.accessibility.mobileNav}>
          <a href={sectionHref('work')}><span>01</span>{copy.nav.work}</a>
          <a href={sectionHref('services')}><span>02</span>{copy.nav.services}</a>
          <a href={sectionHref('about')}><span>03</span>{copy.nav.about}</a>
        </nav>
        <div class="mobile-panel-footer">
          <nav class="language-switcher" aria-label={copy.accessibility.language}>
            <a
              href={locale === 'en' ? Astro.url.pathname : alternatePath}
              lang="en"
              hreflang="en"
              aria-current={locale === 'en' ? 'page' : undefined}>English</a
            >
            <span aria-hidden="true">/</span>
            <a
              href={locale === 'es' ? Astro.url.pathname : alternatePath}
              lang="es"
              hreflang="es"
              aria-current={locale === 'es' ? 'page' : undefined}>Español</a
            >
          </nav>
          <a class="button button--primary" href={sectionHref('contact')}>
            {copy.nav.cta}<Icon name="ArrowUpRight" size={17} />
          </a>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    padding: 0.85rem var(--gutter) 0;
    pointer-events: none;
  }

  .header-shell {
    display: grid;
    width: min(100%, var(--container));
    min-height: 4.3rem;
    align-items: center;
    margin-inline: auto;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    grid-template-columns: 1fr auto 1fr;
    padding: 0.62rem 0.72rem 0.62rem 1rem;
    pointer-events: auto;
    transition:
      background-color var(--duration-normal) ease,
      border-color var(--duration-normal) ease,
      box-shadow var(--duration-normal) ease,
      backdrop-filter var(--duration-normal) ease;
  }

  .site-header[data-scrolled='true'] .header-shell {
    border-color: var(--color-line);
    background: rgb(7 10 7 / 86%);
    box-shadow: 0 12px 44px rgb(0 0 0 / 28%);
    backdrop-filter: blur(18px) saturate(120%);
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.72rem;
  }

  .brand-mark {
    display: grid;
    width: 2.22rem;
    height: 2.22rem;
    place-items: center;
    border: 1px solid rgb(201 255 68 / 30%);
    border-radius: 0.45rem;
    background: rgb(201 255 68 / 6%);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 720;
    letter-spacing: -0.04em;
  }

  :global(.brand-signature) {
    width: 4.5rem;
    height: 2.22rem;
    object-fit: contain;
    object-position: left center;
  }

  .brand-name {
    font-size: 0.92rem;
    font-weight: 670;
    letter-spacing: -0.025em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .desktop-nav a {
    position: relative;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.84rem;
    font-weight: 570;
    padding: 0.75rem 0.85rem;
    transition: color var(--duration-fast) ease;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0.85rem;
    bottom: 0.46rem;
    left: 0.85rem;
    height: 1px;
    background: var(--color-accent);
    content: '';
    scale: 0 1;
    transform-origin: right;
    transition: scale var(--duration-normal) var(--ease-standard);
  }

  .desktop-nav a:hover {
    color: var(--color-text);
  }

  .desktop-nav a:hover::after {
    scale: 1;
    transform-origin: left;
  }

  .desktop-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 1rem;
  }

  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.06em;
  }

  .language-switcher a {
    display: inline-grid;
    min-width: 2rem;
    min-height: 2rem;
    place-items: center;
    border-radius: 0.2rem;
    padding: 0.35rem;
    transition: color var(--duration-fast) ease;
  }

  .language-switcher a:hover,
  .language-switcher a[aria-current='page'] {
    color: var(--color-text);
  }

  .language-switcher a[aria-current='page']::before {
    color: var(--color-accent);
    content: '• ';
  }

  .header-cta {
    display: inline-flex;
    min-height: 2.85rem;
    align-items: center;
    gap: 0.55rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: #10140c;
    font-size: 0.79rem;
    font-weight: 740;
    padding-inline: 1rem;
    transition:
      background-color var(--duration-fast) ease,
      translate var(--duration-fast) var(--ease-standard);
  }

  .header-cta:hover {
    background: var(--color-accent-strong);
    translate: 0 -1px;
  }

  .mobile-menu {
    display: none;
    justify-self: end;
  }

  .mobile-menu summary {
    display: grid;
    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-icon--close,
  .mobile-menu[open] .menu-icon--open {
    display: none;
  }

  .mobile-menu[open] .menu-icon--close {
    display: block;
  }

  .mobile-panel {
    position: fixed;
    z-index: -1;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    justify-content: space-between;
    padding: 8rem var(--gutter) 2rem;
    background:
      radial-gradient(circle at 85% 10%, rgb(181 255 50 / 8%), transparent 18rem), rgb(5 7 5 / 98%);
  }

  .mobile-panel > nav {
    display: grid;
  }

  .mobile-panel > nav > a {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    border-bottom: 1px solid var(--color-line);
    font-size: clamp(2rem, 10vw, 3.4rem);
    font-weight: 560;
    letter-spacing: -0.05em;
    line-height: 1;
    padding-block: 1.25rem;
  }

  .mobile-panel > nav > a span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0;
  }

  .mobile-panel-footer {
    display: grid;
    gap: 1.4rem;
  }

  .mobile-panel-footer .language-switcher {
    font-size: 0.75rem;
  }

  @media (max-width: 61.99rem) {
    .header-shell {
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .desktop-actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 31rem) {
    .brand-name {
      display: none;
    }
  }
</style>
