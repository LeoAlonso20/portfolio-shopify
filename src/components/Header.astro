---
import Icon from './Icon.astro';
import AssetImage from './AssetImage.astro';
import { professionalCopy, professionalPath } from '../config/professional';
import { getUi } from '../i18n/ui';
import { shopifyPath, siteConfig, type Locale } from '../config/site';

interface Props {
  locale: Locale;
  alternatePath: string;
  pathname: string;
  isHome?: boolean;
  variant?: 'shopify' | 'professional';
}

const { locale, alternatePath, pathname, isHome = false, variant = 'shopify' } = Astro.props;
const copy = getUi(locale);
const professionalNav = professionalCopy[locale].nav;
const root = variant === 'professional' ? professionalPath(locale) : shopifyPath(locale);
const logoSrc =
  variant === 'professional' ? siteConfig.assets.professionalLogo : siteConfig.assets.signature;
const brandLabel =
  variant === 'professional' ? professionalCopy[locale].hero.title : copy.footer.tagline;
const sectionHref = (section: string) => (isHome ? `#${section}` : `${root}#${section}`);
const navItems =
  variant === 'professional'
    ? [
        { href: `${pathname}#professional-work`, label: professionalNav.work },
        { href: `${pathname}#expertise`, label: professionalNav.expertise },
        { href: `${pathname}#education`, label: professionalNav.education },
        { href: `${pathname}#certificates`, label: professionalNav.certificates },
        { href: `${pathname}#about`, label: professionalNav.about },
      ]
    : [
        { href: sectionHref('work'), label: copy.nav.work },
        { href: sectionHref('services'), label: copy.nav.services },
        { href: sectionHref('about'), label: copy.nav.about },
      ];
const cta =
  variant === 'professional'
    ? {
        href: `mailto:${siteConfig.email}?subject=${encodeURIComponent(
          locale === 'en' ? 'Professional profile inquiry' : 'Consulta sobre perfil profesional',
        )}`,
        label: professionalNav.contact,
        icon: 'Mail',
      }
    : { href: sectionHref('contact'), label: copy.nav.cta, icon: 'ArrowUpRight' };
---

<header class="site-header" data-site-header data-variant={variant}>
  <div class="header-shell">
    <a class="brand" href={root} aria-label={`Leandro Alonso — ${brandLabel}`}>
      <AssetImage
        src={logoSrc}
        alt=""
        width={240}
        height={96}
        sizes="72px"
        loading="eager"
        class={`brand-signature brand-signature--${variant}`}
      >
        <span class="brand-mark" aria-hidden="true">LA</span>
      </AssetImage>
    </a>

    <nav class="desktop-nav" aria-label={copy.accessibility.primaryNav}>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="desktop-actions">
      <nav class="language-switcher" aria-label={copy.accessibility.language}>
        <a
          href={locale === 'en' ? Astro.url.pathname : alternatePath}
          data-locale="en"
          lang="en"
          hreflang="en"
          aria-current={locale === 'en' ? 'page' : undefined}>EN</a
        >
        <span aria-hidden="true">/</span>
        <a
          href={locale === 'es' ? Astro.url.pathname : alternatePath}
          data-locale="es"
          lang="es"
          hreflang="es"
          aria-current={locale === 'es' ? 'page' : undefined}>ES</a
        >
      </nav>
      <a class="header-cta" href={cta.href}>
        <span>{cta.label}</span>
        <Icon name={cta.icon} size={16} />
      </a>
    </div>

    <details class="mobile-menu" data-mobile-menu>
      <summary
        data-testid="mobile-nav-toggle"
        data-open-label={copy.accessibility.openNav}
        data-close-label={copy.accessibility.closeNav}
        aria-label={copy.accessibility.openNav}
      >
        <span class="menu-icon menu-icon--open"><Icon name="Menu" size={21} /></span>
        <span class="menu-icon menu-icon--close"><Icon name="X" size={21} /></span>
      </summary>
      <div
        class="mobile-panel"
        data-testid="mobile-nav-panel"
        role="dialog"
        aria-modal="true"
        aria-label={copy.accessibility.mobileNav}
      >
        <nav aria-label={copy.accessibility.mobileNav}>
          {
            navItems.map((item, index) => (
              <a href={item.href}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="mobile-panel-footer">
          <nav class="language-switcher" aria-label={copy.accessibility.language}>
            <a
              href={locale === 'en' ? Astro.url.pathname : alternatePath}
              data-locale="en"
              lang="en"
              hreflang="en"
              aria-current={locale === 'en' ? 'page' : undefined}>English</a
            >
            <span aria-hidden="true">/</span>
            <a
              href={locale === 'es' ? Astro.url.pathname : alternatePath}
              data-locale="es"
              lang="es"
              hreflang="es"
              aria-current={locale === 'es' ? 'page' : undefined}>Español</a
            >
          </nav>
          <a class="button button--primary" href={cta.href}>
            {cta.label}<Icon name={cta.icon} size={17} />
          </a>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    --header-accent: var(--color-accent);
    --header-accent-strong: var(--color-accent-strong);
    --header-cta-text: #10140c;
    --header-mobile-glow: rgb(181 255 50 / 8%);
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    padding: 0.85rem var(--gutter) 0;
    pointer-events: none;
  }

  .site-header[data-variant='professional'] {
    --header-accent: #38bdf8;
    --header-accent-strong: #7dd3fc;
    --header-cta-text: #041016;
    --header-mobile-glow: rgb(56 189 248 / 8%);
  }

  .header-shell {
    display: grid;
    width: min(100%, var(--container));
    min-height: 4.3rem;
    align-items: center;
    margin-inline: auto;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    grid-template-columns: 1fr auto 1fr;
    padding: 0.62rem 0.72rem 0.62rem 1rem;
    pointer-events: auto;
    transition:
      background-color var(--duration-normal) ease,
      border-color var(--duration-normal) ease,
      box-shadow var(--duration-normal) ease,
      backdrop-filter var(--duration-normal) ease;
  }

  .site-header[data-scrolled='true'] .header-shell {
    border-color: var(--color-line);
    background: rgb(7 10 7 / 86%);
    box-shadow: 0 12px 44px rgb(0 0 0 / 28%);
    backdrop-filter: blur(18px) saturate(120%);
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.72rem;
  }

  .brand-mark {
    display: grid;
    width: 2.22rem;
    height: 2.22rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--header-accent) 30%, transparent);
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--header-accent) 6%, transparent);
    color: var(--header-accent);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 720;
    letter-spacing: -0.04em;
  }

  :global(.brand-signature) {
    width: 4.5rem;
    height: 2.22rem;
    object-fit: contain;
    object-position: left center;
  }

  :global(.brand-signature--professional) {
    width: min(7.5rem, 22vw);
  }

  .brand-name {
    font-size: 0.92rem;
    font-weight: 670;
    letter-spacing: -0.025em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .desktop-nav a {
    position: relative;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.84rem;
    font-weight: 570;
    padding: 0.75rem 0.85rem;
    transition: color var(--duration-fast) ease;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0.85rem;
    bottom: 0.46rem;
    left: 0.85rem;
    height: 1px;
    background: var(--header-accent);
    content: '';
    scale: 0 1;
    transform-origin: right;
    transition: scale var(--duration-normal) var(--ease-standard);
  }

  .desktop-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 1rem;
  }

  .language-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.06em;
  }

  .language-switcher a {
    display: inline-grid;
    min-width: 2rem;
    min-height: 2rem;
    place-items: center;
    border-radius: 0.2rem;
    padding: 0.35rem;
    transition: color var(--duration-fast) ease;
  }

  .language-switcher a[aria-current='page'] {
    color: var(--color-text);
  }

  .language-switcher a[aria-current='page']::before {
    color: var(--header-accent);
    content: '• ';
  }

  .header-cta {
    --magnetic-x: 0px;
    --magnetic-y: 0px;
    display: inline-flex;
    min-height: 2.85rem;
    align-items: center;
    gap: 0.55rem;
    border-radius: var(--radius-sm);
    background: var(--header-accent);
    color: var(--header-cta-text);
    font-size: 0.79rem;
    font-weight: 740;
    padding-inline: 1rem;
    transform: translate3d(var(--magnetic-x), var(--magnetic-y), 0);
    transition:
      transform var(--duration-normal) var(--ease-out),
      background-color var(--duration-fast) ease,
      translate var(--duration-fast) var(--ease-standard);
  }

  .header-cta :global(svg) {
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .mobile-menu {
    display: none;
    justify-self: end;
  }

  .mobile-menu summary {
    display: grid;
    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-icon--close,
  .mobile-menu[open] .menu-icon--open {
    display: none;
  }

  .mobile-menu[open] .menu-icon--close {
    display: block;
  }

  .mobile-panel {
    position: fixed;
    z-index: -1;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    justify-content: space-between;
    padding: 8rem var(--gutter) 2rem;
    background:
      radial-gradient(circle at 85% 10%, var(--header-mobile-glow), transparent 18rem),
      rgb(5 7 5 / 98%);
  }

  .mobile-panel > nav {
    display: grid;
  }

  .mobile-panel > nav > a {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    border-bottom: 1px solid var(--color-line);
    font-size: clamp(2rem, 10vw, 3.4rem);
    font-weight: 560;
    letter-spacing: -0.05em;
    line-height: 1;
    padding-block: 1.25rem;
  }

  .mobile-panel > nav > a span {
    color: var(--header-accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0;
  }

  .mobile-panel-footer {
    display: grid;
    gap: 1.4rem;
  }

  .site-header[data-variant='professional'] .mobile-panel-footer .button--primary {
    background: var(--header-accent);
    box-shadow: 0 0 0 0 rgb(56 189 248 / 0%);
    color: var(--header-cta-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .desktop-nav a:hover,
    .language-switcher a:hover {
      color: var(--color-text);
    }

    .desktop-nav a:hover::after {
      scale: 1;
      transform-origin: left;
    }

    .header-cta:hover {
      background: var(--header-accent-strong);
      translate: 0 -1px;
    }

    .header-cta:hover :global(svg) {
      transform: translate3d(0.13rem, -0.13rem, 0);
    }

    .site-header[data-variant='professional'] .mobile-panel-footer .button--primary:hover {
      background: var(--header-accent-strong);
      box-shadow: 0 12px 34px rgb(56 189 248 / 17%);
    }
  }

  .mobile-panel-footer .language-switcher {
    font-size: 0.75rem;
  }

  @media (max-width: 61.99rem) {
    .header-shell {
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .desktop-actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 31rem) {
    .brand-name {
      display: none;
    }
  }
</style>
